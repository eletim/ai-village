{
  "name": "ai-village",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI village with a core Codex secretary and a live PurpleMux workshop",
  "scripts": {
    "dev": "node scripts/supervise.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "test:ui": "playwright test",
    "scratch:setup": "sh scripts/setup-scratch.sh",
    "scratch:doctor": "node scripts/diagnose-scratch.mjs",
    "test:scratch": "node scripts/require-scratch.mjs",
    "scratch:preflight": "node scripts/preflight-scratch.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
